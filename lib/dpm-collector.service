[Unit]
Description=DPM-DA530 (DPM-DA510) Modbus RTU Collector (BL118)
After=network.target

[Service]
Type=simple
User=dpm
Group=dpm
WorkingDirectory=/opt/dpm-collector
EnvironmentFile=/opt/dpm-collector/.env
Environment=NODE_OPTIONS=--experimental-sqlite
ExecStart=/usr/bin/node /opt/dpm-collector/index.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dpm-collector

[Install]
WantedBy=multi-user.target
